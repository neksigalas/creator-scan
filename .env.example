# ── YouTube Data API v3 ──────────────────────────────────────────────────────
# Δημιούργησε project στο https://console.cloud.google.com/
# Ενεργοποίησε "YouTube Data API v3"
# APIs & Services → Credentials → Create API Key
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# ── Twitch API ───────────────────────────────────────────────────────────────
# Δημιούργησε app στο https://dev.twitch.tv/console/apps
# Πάρε Client ID + Client Secret
TWITCH_CLIENT_ID=YOUR_TWITCH_CLIENT_ID_HERE
TWITCH_CLIENT_SECRET=YOUR_TWITCH_CLIENT_SECRET_HERE
